#!/usr/bin/env python3
"""Entry point shim. The logic lives in scripts/cli.py so that it is linted and covered."""

import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
for _package in ("scripts", "hooks", "statusline"):
    sys.path.insert(0, str(_ROOT / _package))

from cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
