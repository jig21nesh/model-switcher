#!/usr/bin/env python3
"""Entry point for the model-switcher CLI.

The same file works from two layouts, because it is copied verbatim into the install
directory: the repo, where the modules sit in scripts/, hooks/ and statusline/, and
~/.claude/model-switcher/, where they sit flat alongside this script. The logic lives in
scripts/cli.py so that it is linted and coverage-measured.
"""

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
# _HERE must end up first on sys.path: in the installed layout its siblings are the user's own
# ~/.claude directories, and a hooks/ or scripts/ dir there must not shadow the installed modules.
for _location in (*(_HERE.parent / name for name in ("statusline", "hooks", "scripts")), _HERE):
    if _location.is_dir():
        sys.path.insert(0, str(_location))

from cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
